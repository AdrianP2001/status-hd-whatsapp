<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabecera con Logo y Titulo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/app_icon"
                android:contentDescription="Logo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status HD"
                        android:textColor="@color/whatsapp_green"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVersionTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="#1E293B"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="v1.5"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Optimizador inteligente de fotos y videos para WhatsApp"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tarjeta de Archivo Seleccionado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVideoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvVideoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ningún archivo seleccionado"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVideoDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Comparte una foto o video desde tu Galería o pulsa Seleccionar"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvOptimizationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#15803D"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Modo Auto: Fotos HD (9:16) • Videos 1080p/720p"
                    android:textColor="#DCFCE7"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botones Seleccionar Foto y Video -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectPhoto"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="📷 Foto"
                android:textColor="@color/text_white"
                app:backgroundTint="#334155"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectVideo"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="🎬 Video"
                android:textColor="@color/text_white"
                app:backgroundTint="#334155"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Opciones de División y Recorte de Video (v1.5) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSplitOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✂️ Modo de División de Estados"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Selector de Límite WhatsApp (30s / 60s) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Límite por estado:"
                        android:textColor="@color/text_gray"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleGroupLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLimit30s"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:paddingHorizontal="10dp"
                            android:text="30s (Estándar)"
                            android:textSize="11sp"
                            android:textColor="@color/text_white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLimit60s"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:paddingHorizontal="10dp"
                            android:text="60s (Nuevo)"
                            android:textSize="11sp"
                            android:textColor="@color/text_white" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <!-- Selector de Tipo de División: Balanceado vs Fijo vs Manual -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleGroupSplitMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeBalanced"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="⚖️ Balanceado"
                        android:textSize="11sp"
                        android:textColor="@color/text_white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeFixed"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="⏱️ Fijo"
                        android:textSize="11sp"
                        android:textColor="@color/text_white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeManual"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="✂️ Manual"
                        android:textSize="11sp"
                        android:textColor="@color/text_white" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Resumen en Modo Automático (Balanceado o Fijo) -->
                <TextView
                    android:id="@+id/tvAutoSplitSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#0F172A"
                    android:padding="10dp"
                    android:text="Se dividirá en partes equilibradas"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp" />

                <!-- Sección de Edición Manual / Conversación (Mini reproductor + Cortes) -->
                <LinearLayout
                    android:id="@+id/layoutManualEditor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reproduce y pausa en los silencios para cortar:"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                    <!-- Mini Reproductor con VideoView -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#000000"
                        app:cardCornerRadius="12dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <VideoView
                                android:id="@+id/videoPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center" />

                            <ImageView
                                android:id="@+id/ivPlayPauseOverlay"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:background="#66000000"
                                android:src="@android:drawable/ic_media_play"
                                android:padding="8dp" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Control de Reproducción y Tiempo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tvCurrentVideoTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="@color/text_white"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekBarVideo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:progressTint="@color/whatsapp_green"
                            android:thumbTint="@color/whatsapp_green" />

                        <TextView
                            android:id="@+id/tvTotalVideoTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Botón para marcar corte en la posición actual del video -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMarkCutPoint"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:text="✂️ Marcar corte en este punto"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:backgroundTint="@color/whatsapp_green"
                        app:cornerRadius="10dp" />

                    <!-- Contenedor dinámico de partes cortadas -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Partes resultantes del corte:"
                        android:textColor="@color/text_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerManualCuts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Boton Comprimir y Compartir -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompress"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:enabled="false"
            android:text="Optimizar para WhatsApp"
            android:textColor="#000000"
            android:textStyle="bold"
            app:backgroundTint="@color/whatsapp_green"
            app:cornerRadius="12dp" />

        <!-- Seccion de Progreso Real -->
        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvProgressStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Codificando..."
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/whatsapp_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/whatsapp_green"
                android:progressBackgroundTint="#334155" />
        </LinearLayout>

        <!-- Resultados generados con selección de partes -->
        <LinearLayout
            android:id="@+id/layoutResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvResultsHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Partes listas para enviar:"
                    android:textColor="@color/whatsapp_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectAllToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desmarcar todas"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/resultsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Botón principal para enviar las partes seleccionadas -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareSelected"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="📤 Enviar a WhatsApp"
                android:textColor="#000000"
                android:textStyle="bold"
                app:backgroundTint="@color/whatsapp_green"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
